# CineWave Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your local MongoDB or MongoDB Atlas URI:
# e.g., mongodb://localhost:27017/cinewave or mongodb+srv://<user>:<password>@cluster.mongodb.net/cinewave
MONGODB_URI=mongodb://127.0.0.1:27017/cinewave

# Set to true to automatically use embedded in-memory MongoDB if local daemon is not running:
USE_IN_MEMORY_DB_FALLBACK=true

# JWT Secret & Expiry
JWT_SECRET=cinewave_super_secure_jwt_secret_key_2026_demo
JWT_EXPIRES_IN=7d

# Razorpay Test Mode Credentials
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_cinewave123456
RAZORPAY_KEY_SECRET=rzp_test_secret_cinewave987654

# Razorpay Subscription Pricing
# Amount in INR (Paise): 19900 = ₹199.00
SUBSCRIPTION_PRICE_PAISE=19900
SUBSCRIPTION_CURRENCY=INR
SUBSCRIPTION_DURATION_DAYS=30

# Nodemailer / SMTP Configuration
# Use Mailtrap, Ethereal, Gmail, or your SMTP provider
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=demo_user@ethereal.email
SMTP_PASS=demo_password
SMTP_FROM="CineWave OTT" <no-reply@cinewave.tv>

# Client URL for CORS
CLIENT_URL=http://localhost:5173
